{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "el-chiapaneco",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "throbbing-wind-a494.cloudflareaccess.com",
    "ACCESS_AUD": "4cf7c733c6fcdd0533e6da741f40060d",
    "BUSINESS_TIME_ZONE": "America/Mexico_City"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-chiapaneco-db",
      "database_id": "5ae1cb0e-398b-43ab-8b30-ac0c72df1351"
    }
  ]
}
